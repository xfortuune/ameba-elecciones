# Copia este archivo a .env.local y rellénalo. NUNCA subas .env.local a GitHub.

# Supabase → Project Settings → API / Data API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta del servidor: "secret key" (sb_secret_...) o la antigua "service_role".
# Da acceso total a la BD: solo va en el servidor (Vercel) y en tu .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel /admin
ADMIN_PASSWORD=

# Clave para firmar las cookies de sesión (cadena larga y aleatoria).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: URL pública para las imágenes Open Graph. En Vercel se detecta sola.
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# Solo desarrollo local, sin Supabase: BD en memoria (los PINs salen en la consola).
# USE_MEMORY_STORE=1
# MEMORY_STORE_SEED=1   # precarga 10 votos de prueba para ver la página de resultados
